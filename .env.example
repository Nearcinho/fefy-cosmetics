# ==========================================
# FEFY COSMETICS - Variables de Entorno
# ==========================================
# Copia este archivo a .env y rellena los valores reales
# NUNCA subas .env al repositorio

# Mercado Pago (obligatorias)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Webhook secreto opcional para validar notificaciones
MERCADOPAGO_WEBHOOK_SECRET=

# URL base del sitio (cambiar en producción)
SITE_URL=https://fefy-cosmetics.vercel.app

# Moneda (CLP para Chile, EUR para España)
CURRENCY=EUR

# Entorno
NODE_ENV=development
